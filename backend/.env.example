# Mẫu cấu hình backend. Copy thành .env rồi điền giá trị thật.
#   cp .env.example .env
PORT=5000


# MongoDB — directConnection=true để kết nối thẳng vào single-node replica set
MONGO_URI=mongodb://127.0.0.1:27017/datvietso?replicaSet=rs0&directConnection=true
MONGO_DB=datvietso

# Khoá chủ AES-256-GCM cho tài sản số (64 ký tự hex = 32 byte).
# Sinh khoá: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ASSET_SECRET_KEY=

# --- Bản dùng thử cho khách (ngrok) -----------------------------------------
# DEMO_MODE=true tắt hai endpoint không nên mở ra Internet:
#   /api/auth/demo-accounts  (trả về cả mật khẩu mặc định)
#   /api/assets/digital/:id/reveal-secret  (giải mã key bản quyền)
DEMO_MODE=false

# Mã truy cập đặt TRƯỚC trang đăng nhập, chặn bot quét trúng link ngrok.
# Để trống = tắt cổng vào. Xem backend/middleware/gate.js
GATE_PASSWORD=
